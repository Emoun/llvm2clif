; Issue 8 (see README.md in this directory) in its nondeterministic form: a
; bubble sort of six pseudo-random elements (tests/programs/sort.c reduced).
; Compile it several times; about half of the objects compute
; test(13, -5, 0, 0) == 4095 instead of 5084 (the other inputs of the
; original program pass in every variant). Which compiles are wrong depends
; on the hash-ordered iteration described in issue 6, which decides where
; the re-tagging casts of the smin/smax chains are placed. Source:
;
;   int test(int a, int b, int c, int d) {
;       int arr[6];
;       unsigned seed = (unsigned)a * 2654435761u + 12345u;
;       for (int i = 0; i < 6; i++) { seed = seed * 1103515245u + 12345u; arr[i] = (int)(seed >> 16) % 100 + b; }
;       for (int i = 0; i < 5; i++)
;           for (int j = 0; j < 5 - i; j++)
;               if (arr[j] > arr[j + 1]) { int t = arr[j]; arr[j] = arr[j + 1]; arr[j + 1] = t; }
;       int r = 0;
;       for (int i = 1; i < 6; i++) r += (arr[i - 1] <= arr[i]);
;       return r * 1000 + arr[0] + arr[5];
;   }
function %test(i32 uext, i32 uext, i32 uext, i32 uext) -> i32 uext system_v {
block0(v0: i32, v1: i32, v2: i32, v3: i32):
    v4 = iconst.i32 0x5498_be5d
    v5 = imul v0, v4  ; v4 = 0x5498_be5d
    v6 = iconst.i32 -740551042
    v7 = iadd v5, v6  ; v6 = -740551042
    v8 = iconst.i32 16
    v9 = ushr v7, v8  ; v8 = 16
    v10 = ireduce.i16 v9
    v11 = iconst.i16 100
    v12 = urem v10, v11  ; v11 = 100
    v13 = uextend.i32 v12
    v14 = iadd v13, v1
    v15 = iconst.i32 0x41c6_4e6d
    v16 = imul v7, v15  ; v15 = 0x41c6_4e6d
