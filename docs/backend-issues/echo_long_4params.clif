; Reproducer for the echo.l routing issue (see README.md in this directory).
;
; Four parameters arrive at the first instruction. `v0` is consumed right
; away by a long chain; `v1` is consumed far later (beyond the 31-instruction
; reach, so the backend forwards it with an `echo.l`); `v2` and `v3` are
; unused. The `echo.l` that carries `v1` executes while `v2`/`v3` are still
; queued for the next instruction, and per the ISA `echo.l` forwards *all*
; queued inputs, so `v2`/`v3` travel with `v1` and corrupt the `iadd` that
; consumes it.
;
; Expected: f(7, 3, 0, 0) == (7 + 20) + (3 + 6) == 36.
; Observed on scryer: a wrong result (the far `iadd` adds `v2` instead of 6).
function %echo_long_4params(i32 uext, i32 uext, i32 uext, i32 uext) -> i32 uext system_v {
block0(v0: i32, v1: i32, v2: i32, v3: i32):
    v4 = iconst.i32 1
    v5 = iadd v0, v4
    v6 = iconst.i32 1
    v7 = iadd v5, v6
    v8 = iconst.i32 1
    v9 = iadd v7, v8
    v10 = iconst.i32 1
    v11 = iadd v9, v10
    v12 = iconst.i32 1
    v13 = iadd v11, v12
    v14 = iconst.i32 1
    v15 = iadd v13, v14
    v16 = iconst.i32 1
    v17 = iadd v15, v16
    v18 = iconst.i32 1
    v19 = iadd v17, v18
    v20 = iconst.i32 1
    v21 = iadd v19, v20
    v22 = iconst.i32 1
    v23 = iadd v21, v22
    v24 = iconst.i32 1
    v25 = iadd v23, v24
    v26 = iconst.i32 1
    v27 = iadd v25, v26
    v28 = iconst.i32 1
    v29 = iadd v27, v28
    v30 = iconst.i32 1
    v31 = iadd v29, v30
    v32 = iconst.i32 1
    v33 = iadd v31, v32
    v34 = iconst.i32 1
    v35 = iadd v33, v34
    v36 = iconst.i32 1
    v37 = iadd v35, v36
    v38 = iconst.i32 1
    v39 = iadd v37, v38
    v40 = iconst.i32 1
    v41 = iadd v39, v40
    v42 = iconst.i32 1
    v43 = iadd v41, v42
    v44 = iconst.i32 6
    v45 = iadd v1, v44
    v46 = iadd v43, v45
    return v46
}
